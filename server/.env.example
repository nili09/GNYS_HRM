# Copy this to .env and fill in real values

# REQUIRED — refuse to boot with the word "changeme"
JWT_SECRET=replace-with-a-long-random-secret-string

# Admin seed credentials (used by: npm run seed)
ADMIN_EMAIL=admin@genesys.example
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=HR Admin

# Database path (default: ./data/hrms.db relative to server/)
# DB_PATH=./data/hrms.db

# Server port (default: 8321)
# PORT=8321

# Set to "1" if running behind a reverse proxy (nginx/caddy) that handles HTTPS
# TRUST_PROXY=1

# Set to "production" to serve the built web app from Express
# NODE_ENV=production
