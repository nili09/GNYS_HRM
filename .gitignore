*.msi
node-lts.msi

# ── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/

# ── Test / coverage / build tool temp files ───────────────────
coverage/
.vitest/
*.timestamp-*.mjs
*.err

